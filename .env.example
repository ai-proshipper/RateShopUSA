# Stallion Express v5 — US shop quotes + create when enabled.
# Empty/failed Stallion quotes are skipped; UPS/CP remain required.
# Kill switch: STALLION_ENABLED=false always off.
# STALLION_SCHEDULE=true → Mon 05:00–11:30 America/Toronto (Tue after holiday Monday).
STALLION_ENABLED=true
STALLION_SCHEDULE=true
# Optional one-shot: STALLION_TEST_WINDOW_START / STALLION_TEST_WINDOW_END (ISO)
STALLION_TOKEN=
# Fallback alias also accepted: StallionAPI=
STALLION_BASE_URL=https://ship.stallion.ca/api/v5
QUOTE_TIMEOUT_MS=15000
STALLION_LABEL_TIMEOUT_MS=30000
STALLION_ALLOW_CREATE=true
STALLION_ALLOW_TEST_CREATE=false
STALLION_ALLOW_PROD_CREATE_VOID=false
# Optional last-mile allowlist (quotes stay unfiltered). Empty = any trackable.
# STALLION_LABEL_CARRIERS=USPS,UPS,FEDEX
STALLION_LABEL_CARRIERS=USPS,FEDEX,UPS
# Optional finer filter, e.g. usps.ground_advantage,usps.priority_mail,usps.1
STALLION_LABEL_SERVICES=

# UPS production — OAuth, Rating, Landed Cost; labels gated separately.
UPS_ENV=production
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ACCOUNT_NUMBER=
UPS_RATING_VERSION=v2403
UPS_LANDED_COST_VERSION=v1
UPS_SHIPPING_VERSION=v2409
UPS_QUOTE_TIMEOUT_MS=20000
UPS_LABEL_TIMEOUT_MS=30000
UPS_ALLOW_CREATE=false
UPS_ALLOW_TEST_CREATE=false
UPS_ALLOW_PROD_CREATE_VOID=false

# Canada Post production — OAuth + Rating /prices; labels gated separately.
CANADA_POST_ENV=production
CANADA_POST_CLIENT_ID=
CANADA_POST_CLIENT_SECRET=
CANADA_POST_CUSTOMER_NUMBER=
CANADA_POST_CONTRACT_ID=
CANADA_POST_SERVICE_CODES=USA.EP,USA.XP,USA.TP
CANADA_POST_PICKUP_POSTAL=L1S2E3
CANADA_POST_PAYMENT_METHOD=Account
CANADA_POST_TOKEN_URL=https://api.canadapost-postescanada.ca/prod/devportal-portaildesdeveloppeurs/cpc-api-native-oauth-provider/oauth2/token
CANADA_POST_API_BASE_URL=https://api.canadapost-postescanada.ca/prod/devportal-portaildesdeveloppeurs/rating/v1
CANADA_POST_SHIPPING_API_BASE_URL=https://api.canadapost-postescanada.ca/prod/devportal-portaildesdeveloppeurs/shipping/v1
CANADA_POST_ALLOW_CREATE=false
CANADA_POST_ALLOW_TEST_CREATE=false
CANADA_POST_TRANSMIT_ENABLED=false
CANADA_POST_ALLOW_PROD_CREATE_VOID=false
CANADA_POST_QUOTE_TIMEOUT_MS=20000
# US /prices is slower than CAD DOM. Short rounds abort live USA quotes.
# Dual-race + IPv4 still kills hung CloudFront sockets.
CANADA_POST_PRICES_ROUND_MS=6000
CANADA_POST_OAUTH_ROUND_MS=4000
CANADA_POST_CONNECT_TIMEOUT_MS=3000
CANADA_POST_PRICES_MAX_ROUNDS=3
CANADA_POST_OAUTH_MAX_ROUNDS=2

# Zonos GraphQL landed-cost quotes (ZONOS_API_KEY).
# CP US labels also need ZONOS_ACCOUNT_KEY as X-CPC-Zonos-Key (CP error 8722).
ZONOS_API_KEY=
ZONOS_ACCOUNT_KEY=
ZONOS_BASE_URL=https://api.zonos.com
ZONOS_QUOTE_TIMEOUT_MS=20000

# Local USA webhook (do not register a second ShipHero URL).
# Same path as CAD: POST /webhook/shiphero/label
# When embedded in RateShopping, PUBLIC_BASE_URL / LABELS_PUBLIC_DIR come from CAD.
PORT=3457
PUBLIC_BASE_URL=http://localhost:3457
# LABELS_PUBLIC_DIR=  # optional override (CAD sets this to its public/labels when embedded)
QUOTE_ONLY=true
AUTO_SELECT_WINNER=true
WEBHOOK_DEADLINE_MS=18000
LABEL_RESERVE_MS=5500
LABEL_TIMEOUT_MS=15000
WEBHOOK_DEDUP_TTL_MS=0
# Prefer USA_* when sharing .env with CAD (CAD MAX_LABEL_COST is often 100).
USA_MAX_LABEL_COST=150
USA_MAX_LANDED_COST=500
MAX_LABEL_COST=150
MAX_LANDED_COST=500
# Freak Athlete label print cap (CAD + USA). Matched by ShipHero account_id.
FREAK_ATHLETE_MAX_LABEL_COST=200
FREAK_ATHLETE_ACCOUNT_ID=100970
# Optional: pin US CP services when CANADA_POST_SERVICE_CODES is CAD DOM.*
# CANADA_POST_USA_SERVICE_CODES=USA.EP,USA.XP,USA.TP
SHIPHERO_WEBHOOK_VERIFY_HMAC=false
SHIPHERO_WEBHOOK_SHARED_SECRET=
# Required for US Rate Shop to attach the commercial invoice to the order after print
# (not sent in webhook customs_info — that would print on the thermal). Same token as CAD.
# Access tokens expire ~28 days; set SHIPHERO_REFRESH_TOKEN so the app renews automatically.
SHIPHERO_API_TOKEN=
SHIPHERO_REFRESH_TOKEN=
# Default true. false = still omit customs_info, do not call order_add_attachment.
USA_ATTACH_CUSTOMS_TO_ORDER=true
